# WebCraft 2.0 Environment Configuration
# Copy this file to .env and fill in your values before running locally.

# Application
PORT=4000
NODE_ENV=development
API_VERSION=v1
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Provide a PostgreSQL connection string. Docker is not required locally if you
# have PostgreSQL installed separately or use a hosted instance.
DATABASE_URL="postgresql://webcraft:webcraft@localhost:5432/webcraft?schema=public"

# Redis (BullMQ / caching / refresh tokens)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="replace-with-a-strong-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-strong-random-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Encryption (for stored provider keys at rest - future)
ENCRYPTION_KEY="replace-with-32-byte-encryption-key"

# CORS
CORS_ORIGINS="http://localhost:5173"

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Razorpay (billing)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Object storage (S3-compatible). Filesystem adapter used locally when unset.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="webcraft-dev"

# LLM Providers
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-..."
GEMINI_API_KEY="..."

# Preview sandbox
PREVIEW_SANDBOX_TIMEOUT_MS="30000"
PREVIEW_SANDBOX_MAX_MEMORY_MB="256"

# Credit policy
FREE_DAILY_CREDITS=50
# Razorpay pricing: INR charged per credit (amount = credits * INR_PER_CREDIT * 100 paise)
# TODO(owner): paste INR per credit here
INR_PER_CREDIT=
# TODO(owner): paste currency here (e.g. INR)
RAZORPAY_CURRENCY=
PRO_DAILY_CREDITS=200

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/v1/integrations/github/callback
